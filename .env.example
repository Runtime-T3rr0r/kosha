# ============================================
# KOSHA - ENVIRONMENT VARIABLES (template)
# ============================================
# 1. cp .env.example .env   (.env is gitignored)
# 2. Fill in real values in .env only
# 3. NEVER commit .env, and never paste its contents into Bob or any AI assistant
# See SECURITY.md.
# ============================================

# IBM Cloud API key (only if you use watsonx; Kosha itself does not need it)
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT

BOB_API_KEY=
GITHUB_TOKEN=
# must point at a DISPOSABLE db only
PROD_DB_URL=
